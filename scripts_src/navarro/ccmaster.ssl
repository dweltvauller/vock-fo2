           code which was written.

           Created: Sept 10, 1998

           Updated:
           VOCK changes:
             No RPU or Black_Electric_LIP source ever shipped for this script (SCRIPT_CCMASTER,
             a second Quartermaster distinct from ccqmstr). Rebuilt from the TH layer's decompiled
             ccmaster.int (the layer that actually wins for this NPC) and rewritten into this
             project's usual macro style; no gameplay logic was added or removed. A large block of
             this NPC's own dialog text (msg 105-179, an alternate ID-check/gear-swap scene) is
             unreferenced by the compiled TH script and was left untagged as likely superseded
             content, not fixed.
*/

/* Include Files */

#define SCRIPT_REALNAME "ccmaster"
#include "../headers/define.h"
#include "../headers/navarro.h"

#define NAME                    SCRIPT_CCMASTER
#define TOWN_REP_VAR            GVAR_TOWN_REP_NAVARRO

#include "../headers/command.h"
#include "../headers/talking_heads.h"

/* Standard Script Procedures */
procedure start;
procedure critter_p_proc;
procedure pickup_p_proc;
procedure talk_p_proc;
procedure destroy_p_proc;
procedure look_at_p_proc;
procedure description_p_proc;
procedure use_skill_on_p_proc;
