									end
								end
							end
						end
					end
				end
				set_global_var(55, global_var(55) + -8);
				debug_msg("nckitty" + ": " + "Added " + -8 + " to Town Rep" + "\n");
			end
		end
		if (((global_var(4) + global_var(5)) >= 25) and ((global_var(5) > (2 * global_var(4))) or (global_var(3) == 1))) then begin
			set_global_var(3, 1);
			set_global_var(2, 0);
		end
		set_global_var(0, global_var(0) + -10);
		debug_msg("nckitty" + ": " + "Player gains " + -10 + " Karma Points." + "\n");
		set_global_var(37, 0);
		set_global_var(38, 0);
		set_global_var(39, 0);
		set_global_var(40, 0);
		set_global_var(41, 0);
		set_global_var(42, 0);
		set_global_var(43, 0);
		set_global_var(44, 0);
