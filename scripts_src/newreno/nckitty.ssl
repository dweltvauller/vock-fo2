					tmp_gen_rep := global_var(0) * 2;
				end
				if (tmp_gen_rep >= 1000) then begin
					set_global_var(37, 1);
				end
				else begin
					if (tmp_gen_rep >= 750) then begin
						set_global_var(38, 1);
					end
					else begin
						if (tmp_gen_rep >= 500) then begin
							set_global_var(39, 1);
						end
						else begin
							if (tmp_gen_rep >= 250) then begin
								set_global_var(40, 1);
							end
							else begin
								if (tmp_gen_rep > -250) then begin
									set_global_var(41, 1);
								end
								else begin
									if (tmp_gen_rep > -500) then begin
										set_global_var(42, 1);
									end
									else begin
										if (tmp_gen_rep > -750) then begin
											set_global_var(43, 1);
										end
										else begin
											if (tmp_gen_rep > -1000) then begin
